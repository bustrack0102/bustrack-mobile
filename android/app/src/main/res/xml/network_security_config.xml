<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Bloqueo estricto de tráfico no cifrado en producción (OWASP MASVS-NET-1) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
